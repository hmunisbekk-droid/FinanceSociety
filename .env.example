# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → "anon public" key (the "publishable" key also works)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" key.
# Server-only: used by admin scripts and server actions that must bypass row security.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → "Connect" button (top of the dashboard) → Session pooler → URI.
# Used only by `npm run db:push` to apply database migrations.
DATABASE_URL=

# Comma-separated list of email domains allowed to sign up, e.g. students.wiut.uz
# Leave empty to allow any email address.
ALLOWED_EMAIL_DOMAINS=

# Public address of the site, used for auth redirects and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
